/index.html
  Cache-Control: no-cache

/app-v7.mjs
  Cache-Control: public, max-age=3600, must-revalidate

/style.css
  Cache-Control: public, max-age=3600, must-revalidate

/city-config.json
  Cache-Control: no-cache

/city/*
  Cache-Control: public, max-age=86400, must-revalidate

/dem/*
  Cache-Control: public, max-age=604800, must-revalidate

/vendor/*
  Cache-Control: public, max-age=604800, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://tile.opentopomap.org https://owsproxy.lgl-bw.de; connect-src 'self' https://tiles.openfreemap.org https://photon.komoot.io https://api.open-meteo.com https://138.2.184.1 https://tile.openstreetmap.org https://tile.opentopomap.org https://owsproxy.lgl-bw.de; font-src 'self' https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Frame-Options: DENY
